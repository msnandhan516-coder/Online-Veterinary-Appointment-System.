# VETNEST Environment Configuration
# Copy this file to .env for local development

# Django Secret Key (Generate a random string for production)
SECRET_KEY=your-secure-random-secret-key-here

# Debug mode (Set to False in production)
DEBUG=True

# Allowed hosts (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CSRF Trusted Origins (comma separated)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# Database URL (Leave blank to use local SQLite, or enter PostgreSQL connection string)
# Example: postgres://username:password@hostname:5432/dbname
DATABASE_URL=

# Email Settings (Optional - required for live appointment email notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-clinic-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=your-clinic-email@gmail.com
